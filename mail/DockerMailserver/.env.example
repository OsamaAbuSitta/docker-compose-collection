# Docker Mailserver Configuration

# Port Configuration
SMTP_PORT=25
SUBMISSION_PORT=587
SMTPS_PORT=465
IMAP_PORT=143
IMAPS_PORT=993

# Timezone
TZ=UTC

# Mail Configuration
HOSTNAME=mail.example.com
DOMAIN=example.com

# Features
ENABLE_SPAMASSASSIN=1
ENABLE_CLAMAV=1
ENABLE_FAIL2BAN=1
ENABLE_OPENDKIM=1
ENABLE_OPENDMARC=1
