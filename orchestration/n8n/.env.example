# n8n Configuration

# Port Configuration
N8N_PORT=5678

# Timezone
TZ=UTC

# n8n Configuration
N8N_HOST=localhost
N8N_INTERNAL_PORT=5678
N8N_PROTOCOL=http
WEBHOOK_URL=http://localhost:5678/

# Encryption Key (must be 32 characters)
ENCRYPTION_KEY=changeme_32_character_secret_key

# Execution Data Settings
SAVE_ON_ERROR=all
SAVE_ON_SUCCESS=all
SAVE_MANUAL=true

# Metrics
METRICS_ENABLED=false

# Database Configuration
DB_HOST=n8n-db
DB_PORT=5432
DB_DATABASE=n8n
DB_USERNAME=n8n
DB_PASSWORD=P@ss0rd123

# PostgreSQL Configuration
POSTGRES_USER=n8n
POSTGRES_PASSWORD=P@ss0rd123
POSTGRES_DB=n8n
