# Gitea Configuration

# Port Configuration
GITEA_HTTP_PORT=3000
GITEA_SSH_PORT=2223

# Domain Configuration
GITEA_DOMAIN=localhost

# User/Group ID (should match host user for file permissions)
USER_UID=1000
USER_GID=1000

# Security Configuration
# Generate secure keys for production:
# - SECRET_KEY: minimum 64 characters
# - INTERNAL_TOKEN: use `gitea generate secret INTERNAL_TOKEN`
GITEA_SECRET_KEY=changeme_secret_key_min_64_chars_changeme_secret_key_min_64_chars
GITEA_INTERNAL_TOKEN=changeme_internal_token

# Installation Lock
# Set to true after initial setup to prevent reinstallation
GITEA_INSTALL_LOCK=false

# PostgreSQL Database Configuration
POSTGRES_USER=gitea
POSTGRES_PASSWORD=P@ssw0rd@123
POSTGRES_DB=gitea

# Timezone
TZ=UTC
