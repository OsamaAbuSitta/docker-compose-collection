# Nexus Repository Configuration

# Port Configuration
NEXUS_HTTP_PORT=8081
NEXUS_DOCKER_PORT=8082

# Memory Configuration
# Adjust based on your system resources
# Minimum recommended: 2703m (2.7GB)
NEXUS_MIN_HEAP=2703m
NEXUS_MAX_HEAP=2703m
NEXUS_MAX_DIRECT_MEMORY=2703m

# Context Path
# Set to / for root path or /nexus for subpath
NEXUS_CONTEXT=/

# Timezone
TZ=UTC
