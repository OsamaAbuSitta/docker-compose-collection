# Apache Pulsar Configuration

# Port Configuration
PULSAR_PORT=6650
PULSAR_HTTP_PORT=8080

# Timezone
TZ=UTC

# JVM Memory Settings
# Format: -Xms<initial_heap> -Xmx<max_heap> -XX:MaxDirectMemorySize=<direct_memory>
# Adjust based on your system resources and workload
PULSAR_MEM=-Xms512m -Xmx512m -XX:MaxDirectMemorySize=256m
