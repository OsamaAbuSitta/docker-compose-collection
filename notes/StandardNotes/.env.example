# Standard Notes Configuration

# Port Configuration
STANDARDNOTES_PORT=3000

# Timezone
TZ=UTC

# Application Secrets (MUST be at least 32 characters)
AUTH_JWT_SECRET=changeme_auth_jwt_secret_min_32_chars
ENCRYPTION_SERVER_KEY=changeme_encryption_key_min_32_chars
VALET_TOKEN_SECRET=changeme_valet_token_secret_min_32_chars

# Database Configuration
DB_HOST=standardnotes-db
DB_PORT=3306
DB_DATABASE=standardnotes
DB_USERNAME=standardnotes
DB_PASSWORD=P@ss0rd123
DB_TYPE=mysql

# Redis Configuration
REDIS_URL=redis://standardnotes-redis:6379

# MySQL Configuration
MYSQL_ROOT_PASSWORD=P@ss0rd123
